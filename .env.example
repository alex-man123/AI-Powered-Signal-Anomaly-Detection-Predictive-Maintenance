# Copy this file to .env and fill in real values. Never commit .env.

# Connection string for the application database.
DATABASE_URL=

# Directory where trained models are stored/loaded from.
MODEL_DIR=

# Directory where raw/processed/external data is stored.
DATA_DIR=

# Application log level (e.g. DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=

# Comma-separated list of origins allowed by backend CORS (frontend dev server by default).
CORS_ORIGINS=http://localhost:5173
